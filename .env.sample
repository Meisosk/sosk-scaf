# All Supabase values: https://supabase.com/dashboard -> open this project -> Project Settings (gear icon)

# Project Settings -> Data API (or API) -> Project URL
# Use the base URL only (https://<ref>.supabase.co), without /rest/v1/
VITE_SUPABASE_URL=

# Same Project URL as VITE_SUPABASE_URL (used by the server)
SUPABASE_URL=

# Project Settings -> API Keys -> anon / public key
# (newer projects: "Publishable key", or the old one under the "Legacy API keys" tab)
# Safe for the browser; protected by Row Level Security
VITE_SUPABASE_ANON_KEY=

# Project Settings -> API Keys -> service_role key (click Reveal)
# (newer projects: "Secret key", or the old one under the "Legacy API keys" tab)
# SERVER ONLY: bypasses Row Level Security. Never give it a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Port for the local API server in server/ (pick any free port)
PORT=3001
